@model List<JobPortPro.Models.SavedJob>
@{
    ViewData["Title"] = "Saved Jobs";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Bookmarked Jobs</h2>
            <p class="text-muted small mb-0">Saved positions you're interested in applying for</p>
        </div>
        <div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Browse More Jobs
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="text-muted mb-3">
                <i class="fa-regular fa-bookmark fs-1"></i>
            </div>
            <h5 class="fw-bold mb-1">No Saved Jobs</h5>
            <p class="text-muted small mb-3">You haven't bookmarked any jobs yet. When browsing jobs, click 'Save Job' to store them here.</p>
            <div>
                <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary btn-sm rounded-pill px-4">Browse Jobs Now</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var saved in Model)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <div class="company-logo-box">
                                    @(saved.Job?.Employer?.CompanyProfile?.CompanyName?.Substring(0, 1).ToUpper() ?? "C")
                                </div>
                            </div>
                            <div class="col">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <span class="badge @(saved.Job?.JobType == "Remote" ? "badge-soft-success" : saved.Job?.JobType == "Full-Time" ? "badge-soft-primary" : "badge-soft-warning") rounded-pill px-3">
                                        @(saved.Job?.JobType ?? "Full-Time")
                                    </span>
                                    <span class="badge bg-light text-secondary rounded-pill border">
                                        @(saved.Job?.Category?.Name ?? "General")
                                    </span>
                                </div>

                                <h5 class="fw-bold mb-1">
                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@saved.JobId" class="text-dark text-decoration-none">
                                        @(saved.Job?.Title ?? "Position")
                                    </a>
                                </h5>

                                <div class="d-flex flex-wrap gap-3 text-muted small">
                                    <span class="fw-semibold text-primary">
                                        <i class="fa-solid fa-building me-1"></i>@(saved.Job?.Employer?.CompanyProfile?.CompanyName ?? "Company")
                                    </span>
                                    <span>
                                        <i class="fa-solid fa-location-dot me-1 text-secondary"></i>@(saved.Job?.Location ?? "")
                                    </span>
                                    @if (saved.Job != null && (saved.Job.SalaryMin.HasValue || saved.Job.SalaryMax.HasValue))
                                    {
                                        <span class="text-success fw-semibold">
                                            <i class="fa-solid fa-indian-rupee-sign me-1"></i>@string.Format("{0:N0}", saved.Job.SalaryMin) - @string.Format("{0:N0}", saved.Job.SalaryMax)
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="col-12 col-md-auto text-md-end d-flex flex-md-column gap-2 justify-content-between align-items-end">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@saved.JobId" class="btn btn-primary btn-sm rounded-pill px-4">
                                    Apply Now
                                </a>
                                <form asp-controller="Jobs" asp-action="ToggleSave" asp-route-id="@saved.JobId" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-link text-muted text-decoration-none btn-sm small p-0">
                                        <i class="fa-solid fa-trash me-1 text-danger"></i> Remove Bookmark
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
