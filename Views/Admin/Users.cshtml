@model JobPortPro.Models.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-muted small mb-0">Search, monitor, and manage platform user accounts</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Admin Dashboard
        </a>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" value="@Model.SearchQuery" class="form-control bg-light border-0" placeholder="Search by name or email..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="role" class="form-select bg-light border-0">
                    <option value="All" selected="@(Model.RoleFilter == "All")">All Roles</option>
                    <option value="JobSeeker" selected="@(Model.RoleFilter == "JobSeeker")">Job Seekers</option>
                    <option value="Employer" selected="@(Model.RoleFilter == "Employer")">Employers</option>
                    <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admins</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-pill">
                    Filter Users
                </button>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">User Details</th>
                        <th>Role</th>
                        <th>Profile / Company</th>
                        <th>Phone</th>
                        <th>Joined</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Users.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-user-slash fs-1 d-block mb-2 opacity-50"></i>
                                No users matched your search criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@user.FullName</div>
                                <small class="text-muted">@user.Email</small>
                            </td>
                            <td>
                                <span class="badge @(user.Role == "Employer" ? "bg-success-subtle text-success" : user.Role == "Admin" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill px-3 py-1">
                                    @user.Role
                                </span>
                            </td>
                            <td class="small">
                                @if (user.Role == "Employer")
                                {
                                    <span class="fw-semibold text-dark">@(user.CompanyProfile?.CompanyName ?? "No Company Profile")</span>
                                }
                                else if (user.Role == "JobSeeker")
                                {
                                    <span class="text-muted">@(user.JobSeekerProfile?.Headline ?? "Candidate")</span>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold">System Administrator</span>
                                }
                            </td>
                            <td class="small text-muted">@(user.PhoneNumber ?? "—")</td>
                            <td class="small text-muted">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="text-end pe-4">
                                @if (user.Role != "Admin")
                                {
                                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                            <i class="fa-solid fa-trash me-1"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
