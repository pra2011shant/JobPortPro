@model JobPortPro.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Control Center";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 mb-2 fw-semibold">
                <i class="fa-solid fa-shield-halved me-1"></i> System Administration
            </span>
            <h2 class="fw-bold mb-0">Platform Overview & Metrics</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Users" class="btn btn-outline-primary rounded-pill px-3">
                <i class="fa-solid fa-users me-1"></i> Manage Users
            </a>
            <a asp-action="Jobs" class="btn btn-primary rounded-pill px-3">
                <i class="fa-solid fa-briefcase me-1"></i> Manage Jobs
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center h-100">
                <div class="text-primary fw-extrabold fs-3">@Model.TotalUsers</div>
                <div class="text-muted small fw-medium">Total Users</div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center h-100">
                <div class="text-info fw-extrabold fs-3">@Model.TotalJobSeekers</div>
                <div class="text-muted small fw-medium">Job Seekers</div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center h-100">
                <div class="text-success fw-extrabold fs-3">@Model.TotalEmployers</div>
                <div class="text-muted small fw-medium">Employers</div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center h-100">
                <div class="text-warning fw-extrabold fs-3">@Model.TotalJobs</div>
                <div class="text-muted small fw-medium">Total Jobs</div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center h-100">
                <div class="text-primary fw-extrabold fs-3">@Model.ActiveJobs</div>
                <div class="text-muted small fw-medium">Active Postings</div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white text-center h-100">
                <div class="text-danger fw-extrabold fs-3">@Model.TotalApplications</div>
                <div class="text-muted small fw-medium">Applications</div>
            </div>
        </div>
    </div>

    <!-- Recent Tables -->
    <div class="row g-4">
        <!-- Recent Users -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-transparent border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Newly Registered Users</h5>
                    <a asp-action="Users" class="btn btn-sm btn-link text-decoration-none">View All</a>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>User</th>
                                    <th>Role</th>
                                    <th>Joined</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@u.FullName</div>
                                            <small class="text-muted">@u.Email</small>
                                        </td>
                                        <td>
                                            <span class="badge @(u.Role == "Employer" ? "bg-success-subtle text-success" : u.Role == "Admin" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill">
                                                @u.Role
                                            </span>
                                        </td>
                                        <td class="small text-muted">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Jobs -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white h-100">
                <div class="card-header bg-transparent border-0 p-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Latest Job Postings</h5>
                    <a asp-action="Jobs" class="btn btn-sm btn-link text-decoration-none">View All</a>
                </div>
                <div class="card-body p-4">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Company</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var j in Model.RecentJobs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@j.Title</div>
                                            <small class="text-muted">@(j.Category?.Name ?? "General") • @j.Location</small>
                                        </td>
                                        <td class="small">@(j.Employer?.CompanyProfile?.CompanyName ?? "Company")</td>
                                        <td>
                                            <span class="badge @(j.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                                @(j.IsActive ? "Active" : "Closed")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
