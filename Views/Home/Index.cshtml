@model JobPortPro.Models.HomeIndexViewModel
@{
    ViewData["Title"] = "Find Your Next Dream Job";
}

<!-- Hero Section -->
<section class="hero-section text-white text-center py-5">
    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-3 fw-semibold">
                    <i class="fa-solid fa-sparkles me-1 text-primary"></i> Discover 1,000+ Top Tech & Corporate Careers
                </span>
                <h1 class="display-4 fw-extrabold text-white mb-3">
                    Unlock Your Potential with <span class="text-secondary-gradient">JobPortPro</span>
                </h1>
                <p class="lead text-light opacity-75 mb-4">
                    Connect with hiring managers at high-growth startups and leading enterprises. Verified roles, competitive salaries, seamless applications.
                </p>

                <!-- Search Box Card -->
                <div class="hero-search-card p-3 p-md-4 text-start">
                    <form asp-controller="Jobs" asp-action="Index" method="get">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-4">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-0 text-muted ps-2"><i class="fa-solid fa-magnifying-glass"></i></span>
                                    <input type="text" name="q" class="form-control border-0 bg-white" placeholder="Job title, keyword, or skills...">
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-0 text-muted ps-2"><i class="fa-solid fa-layer-group"></i></span>
                                    <select name="categoryId" class="form-select border-0 bg-white">
                                        <option value="">All Categories</option>
                                        @foreach (var cat in Model.Categories)
                                        {
                                            <option value="@cat.Id">@cat.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-0 text-muted ps-2"><i class="fa-solid fa-location-dot"></i></span>
                                    <input type="text" name="location" class="form-control border-0 bg-white" placeholder="City or Remote">
                                </div>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                                    <i class="fa-solid fa-search me-1"></i> Search
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Popular Search Tags -->
                <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mt-4 small">
                    <span class="text-light opacity-75">Popular:</span>
                    <a asp-controller="Jobs" asp-action="Index" asp-route-q=".NET" class="badge bg-dark-subtle text-white text-decoration-none rounded-pill px-3 py-1">.NET Core</a>
                    <a asp-controller="Jobs" asp-action="Index" asp-route-q="Remote" class="badge bg-dark-subtle text-white text-decoration-none rounded-pill px-3 py-1">Remote</a>
                    <a asp-controller="Jobs" asp-action="Index" asp-route-q="UI/UX" class="badge bg-dark-subtle text-white text-decoration-none rounded-pill px-3 py-1">UI/UX Design</a>
                    <a asp-controller="Jobs" asp-action="Index" asp-route-q="DevOps" class="badge bg-dark-subtle text-white text-decoration-none rounded-pill px-3 py-1">DevOps</a>
                    <a asp-controller="Jobs" asp-action="Index" asp-route-q="Full Stack" class="badge bg-dark-subtle text-white text-decoration-none rounded-pill px-3 py-1">Full Stack</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="py-4 bg-white border-bottom shadow-xs">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="fw-bold fs-3 text-primary">@Model.TotalJobs+</div>
                <div class="small text-muted fw-medium">Active Job Openings</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fw-bold fs-3 text-success">@Model.TotalCompanies+</div>
                <div class="small text-muted fw-medium">Partner Companies</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fw-bold fs-3 text-info">@Model.TotalCandidates+</div>
                <div class="small text-muted fw-medium">Verified Job Seekers</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fw-bold fs-3 text-warning">@Model.TotalApplications+</div>
                <div class="small text-muted fw-medium">Applications Processed</div>
            </div>
        </div>
    </div>
</section>

<!-- Browse by Category Section -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small tracking-wider">Explore Sectors</span>
                <h2 class="fw-bold mb-0">Browse by Industry Category</h2>
            </div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3 d-none d-sm-inline-flex align-items-center">
                All Categories <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var cat in Model.Categories.Take(8))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Jobs" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-card h-100 shadow-sm">
                        <div class="category-icon-box">
                            <i class="@cat.IconClass"></i>
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">@cat.Name</h6>
                        <p class="text-muted small mb-0">@(cat.Jobs?.Count ?? 0) Open Positions</p>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Jobs Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-bold text-uppercase small tracking-wider">Top Opportunities</span>
                <h2 class="fw-bold mb-0">Featured Job Openings</h2>
            </div>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                View All Jobs <i class="fa-solid fa-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var job in Model.FeaturedJobs)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="job-card p-4 h-100 d-flex flex-column shadow-sm">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="company-logo-box">
                                @(job.Employer?.CompanyProfile?.CompanyName?.Substring(0, 1).ToUpper() ?? "C")
                            </div>
                            <span class="badge @((job.JobTypeEntity?.Name ?? job.JobType) == "Remote" ? "badge-soft-success" : (job.JobTypeEntity?.Name ?? job.JobType) == "Full-Time" ? "badge-soft-primary" : "badge-soft-warning") rounded-pill px-3 py-1">
                                @(job.JobTypeEntity?.Name ?? job.JobType)
                            </span>
                        </div>

                        <div class="mb-2">
                            <span class="text-muted small fw-medium">@(job.Employer?.CompanyProfile?.CompanyName ?? "Company")</span>
                            <h5 class="fw-bold mb-1">
                                <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="text-dark text-decoration-none">
                                    @job.Title
                                </a>
                            </h5>
                        </div>

                        <div class="d-flex flex-wrap gap-2 text-muted small mb-3">
                            <span><i class="fa-solid fa-location-dot me-1 text-primary"></i>@job.Location</span>
                            @if (job.SalaryMin.HasValue || job.SalaryMax.HasValue)
                            {
                                <span><i class="fa-solid fa-indian-rupee-sign me-1 text-success"></i>@string.Format("{0:N0}", job.SalaryMin) - @string.Format("{0:N0}", job.SalaryMax)</span>
                            }
                        </div>

                        <p class="text-muted small text-truncate-2 flex-grow-1 mb-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @job.Description
                        </p>

                        <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                            <span class="badge bg-light text-secondary rounded-pill border">
                                @(job.Category?.Name ?? "General")
                            </span>
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn btn-primary btn-sm rounded-pill px-3">
                                Apply Now
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="py-5">
    <div class="container">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="text-primary fw-bold text-uppercase small tracking-wider">Simple Process</span>
            <h2 class="display-6 fw-bold">How JobPortPro Works</h2>
            <p class="text-muted">Simple, streamlined workflow for both ambitious candidates and innovative employers.</p>
        </div>

        <div class="row g-4 text-center">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="stat-icon bg-primary-subtle text-primary mx-auto mb-3">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                    <h5 class="fw-bold mb-2">1. Create Profile</h5>
                    <p class="text-muted small mb-0">Build your candidate profile or register your company account with verified details in seconds.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="stat-icon bg-success-subtle text-success mx-auto mb-3">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </div>
                    <h5 class="fw-bold mb-2">2. Search or Post</h5>
                    <p class="text-muted small mb-0">Candidates discover tailored job listings; employers post targeted requirements to attract top performers.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
                    <div class="stat-icon bg-info-subtle text-info mx-auto mb-3">
                        <i class="fa-solid fa-handshake"></i>
                    </div>
                    <h5 class="fw-bold mb-2">3. Connect & Get Hired</h5>
                    <p class="text-muted small mb-0">Direct application management, instant resume reviews, and quick shortlisting with status feedback.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 bg-dark text-white text-center">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="display-6 fw-bold mb-3">Ready to Take Your Career to the Next Level?</h2>
                <p class="lead text-light opacity-75 mb-4">Join JobPortPro today to discover verified openings and hire world-class talent.</p>
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Account" asp-action="Register" asp-route-role="JobSeeker" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-user-graduate me-1"></i> Register as Candidate
                    </a>
                    <a asp-controller="Account" asp-action="Register" asp-route-role="Employer" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-building me-1"></i> Post Jobs as Employer
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
