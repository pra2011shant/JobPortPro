@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="text-primary fw-bold text-uppercase small tracking-wider">About JobPortPro</span>
            <h1 class="display-5 fw-bold mb-3">Connecting Visionary Companies with High-Impact Talent</h1>
            <p class="lead text-muted mb-4">
                JobPortPro is a modern recruitment and job discovery platform built on ASP.NET Core MVC and Microsoft SQL Server. We simplify the hiring journey for both candidates and enterprises.
            </p>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                        <span class="fw-semibold">100% Verified Job Openings</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                        <span class="fw-semibold">Real-time Application Status</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                        <span class="fw-semibold">Direct Employer Hiring</span>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-check text-primary fs-5"></i>
                        <span class="fw-semibold">Smart Resume Management</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 p-4 bg-primary text-white position-relative overflow-hidden">
                <div class="position-absolute end-0 bottom-0 opacity-10 p-3" style="font-size: 15rem; line-height: 0.8;">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <h3 class="fw-bold mb-3">Our Core Mission</h3>
                <p class="text-light opacity-90 mb-4">
                    To eliminate friction in the tech and corporate recruitment landscape by empowering job seekers to showcase their real capabilities and enabling employers to hire faster and smarter.
                </p>
                <div class="border-top border-white border-opacity-25 pt-3">
                    <div class="d-flex gap-4">
                        <div>
                            <h4 class="fw-bold mb-0">10k+</h4>
                            <small class="text-light opacity-75">Interviews Scheduled</small>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">98%</h4>
                            <small class="text-light opacity-75">Satisfaction Rate</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
