@model List<JobPortPro.Models.Job>
@{
    ViewData["Title"] = "Manage Jobs";
    string currentStatus = ViewBag.CurrentStatus as string ?? "";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Manage Job Postings</h2>
            <p class="text-muted small mb-0">Review status, applicant counts, and edit or close postings</p>
        </div>
        <div>
            <a asp-action="PostJob" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Post New Job
            </a>
        </div>
    </div>

    <!-- Status Tabs Filter -->
    <ul class="nav nav-pills mb-4 gap-2">
        <li class="nav-item">
            <a class="nav-link rounded-pill @(string.IsNullOrEmpty(currentStatus) ? "active" : "bg-white text-muted border")" asp-action="ManageJobs">
                All Jobs (@Model.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill @(currentStatus == "active" ? "active" : "bg-white text-muted border")" asp-action="ManageJobs" asp-route-status="active">
                Active
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill @(currentStatus == "inactive" ? "active" : "bg-white text-muted border")" asp-action="ManageJobs" asp-route-status="inactive">
                Closed
            </a>
        </li>
    </ul>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-folder-open fs-1"></i>
            </div>
            <h5 class="fw-bold mb-1">No Jobs Found</h5>
            <p class="text-muted small mb-3">You haven't posted any jobs in this category yet.</p>
            <div>
                <a asp-action="PostJob" class="btn btn-primary btn-sm rounded-pill px-4">Post Your First Job</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Job Title & Details</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Applicants</th>
                            <th>Posted On</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@job.Title</div>
                                    <span class="text-muted small">@job.Location • @job.JobType</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary rounded-pill border">
                                        @(job.Category?.Name ?? "General")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(job.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill px-2 py-1">
                                        @(job.IsActive ? "Active" : "Closed")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Applicants" asp-route-jobId="@job.Id" class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1 text-decoration-none">
                                        <i class="fa-solid fa-users me-1"></i> @(job.Applications?.Count ?? 0) Applicants
                                    </a>
                                </td>
                                <td>
                                    <span class="small text-muted">@job.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" target="_blank" class="btn btn-sm btn-light" title="Preview Listing">
                                            <i class="fa-solid fa-eye text-muted"></i>
                                        </a>
                                        <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-sm btn-light" title="Edit">
                                            <i class="fa-solid fa-pen text-muted"></i>
                                        </a>
                                        <form asp-action="ToggleJobStatus" asp-route-id="@job.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light" title="@(job.IsActive ? "Close Job" : "Activate Job")">
                                                <i class="fa-solid @(job.IsActive ? "fa-pause text-warning" : "fa-play text-success")"></i>
                                            </button>
                                        </form>
                                        <form asp-action="DeleteJob" asp-route-id="@job.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this job posting?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light" title="Delete">
                                                <i class="fa-solid fa-trash text-danger"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
