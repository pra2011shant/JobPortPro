@model JobPortPro.Models.EmployerDashboardViewModel
@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Employer Dashboard</h2>
            <p class="text-muted small mb-0">Manage your active job postings and candidate pipelines</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PostJob" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="fa-solid fa-plus me-1"></i> Post New Job
            </a>
            <a asp-action="ManageJobs" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-list-check me-1"></i> All Jobs
            </a>
        </div>
    </div>

    <!-- Analytics Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-6 col-lg-3">
            <div class="stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Total Jobs Posted</div>
                        <h3 class="fw-bold mb-0 mt-1">@Model.TotalJobsPosted</h3>
                    </div>
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Active Postings</div>
                        <h3 class="fw-bold mb-0 mt-1 text-success">@Model.ActiveJobs</h3>
                    </div>
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Total Applications</div>
                        <h3 class="fw-bold mb-0 mt-1 text-info">@Model.TotalApplications</h3>
                    </div>
                    <div class="stat-icon bg-info-subtle text-info">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="stat-card shadow-sm">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-medium">Shortlisted Talent</div>
                        <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.ShortlistedApplications</h3>
                    </div>
                    <div class="stat-icon bg-warning-subtle text-warning">
                        <i class="fa-solid fa-star"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Postings & Recent Applicants Grid -->
    <div class="row g-4">
        <!-- Recent Posted Jobs -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Job Postings</h5>
                    <a asp-action="ManageJobs" class="text-primary small text-decoration-none fw-semibold">View All</a>
                </div>

                @if (!Model.RecentJobs.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-inbox fs-2 mb-2"></i>
                        <p class="small mb-2">No jobs posted yet.</p>
                        <a asp-action="PostJob" class="btn btn-sm btn-primary rounded-pill">Create Your First Job</a>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th>Job Title</th>
                                    <th>Status</th>
                                    <th>Applicants</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @foreach (var job in Model.RecentJobs)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@job.Title</div>
                                            <span class="text-muted" style="font-size: 0.75rem;">@job.Location • @job.JobType</span>
                                        </td>
                                        <td>
                                            <span class="badge @(job.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill">
                                                @(job.IsActive ? "Active" : "Closed")
                                            </span>
                                        </td>
                                        <td>
                                            <a asp-action="Applicants" asp-route-jobId="@job.Id" class="badge bg-primary-subtle text-primary text-decoration-none rounded-pill px-2">
                                                @(job.Applications?.Count ?? 0) Applied
                                            </a>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-sm btn-light py-0 px-2" title="Edit">
                                                <i class="fa-solid fa-pen-to-square text-muted"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Recent Applications -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">Recent Applications Received</h5>
                    <a asp-action="Applicants" class="text-primary small text-decoration-none fw-semibold">View All</a>
                </div>

                @if (!Model.RecentApplications.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="fa-solid fa-envelope-open fs-2 mb-2"></i>
                        <p class="small mb-0">No applications received yet.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var app in Model.RecentApplications)
                        {
                            <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded-3">
                                <div>
                                    <div class="fw-bold text-dark">@(app.JobSeeker?.FullName ?? "Applicant")</div>
                                    <div class="text-muted small">Applied for <span class="fw-semibold">@(app.Job?.Title ?? "Job")</span></div>
                                    <span class="text-muted" style="font-size: 0.75rem;">@app.AppliedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                <div class="text-end">
                                    <span class="badge @(app.Status == "Shortlisted" ? "bg-warning-subtle text-warning" : app.Status == "Accepted" ? "bg-success-subtle text-success" : app.Status == "Rejected" ? "bg-danger-subtle text-danger" : "bg-primary-subtle text-primary") rounded-pill mb-1">
                                        @app.Status
                                    </span>
                                    <div>
                                        <a asp-action="ApplicantDetail" asp-route-id="@app.Id" class="btn btn-sm btn-primary py-0 px-2 rounded-pill" style="font-size: 0.75rem;">
                                            Review
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
