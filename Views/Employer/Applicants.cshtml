@model List<JobPortPro.Models.JobApplication>
@{
    ViewData["Title"] = "Applicant Tracking";
    var employerJobs = ViewBag.EmployerJobs as List<JobPortPro.Models.Job> ?? new List<JobPortPro.Models.Job>();
    int? selectedJobId = ViewBag.SelectedJobId as int?;
    string? selectedStatus = ViewBag.SelectedStatus as string;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Applicant Tracking System</h2>
            <p class="text-muted small mb-0">Review candidates, download resumes, and manage recruitment pipeline</p>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Job Posting</label>
                <select name="jobId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Job Postings</option>
                    @foreach (var job in employerJobs)
                    {
                        if (selectedJobId == job.Id)
                        {
                            <option value="@job.Id" selected>@job.Title</option>
                        }
                        else
                        {
                            <option value="@job.Id">@job.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Application Statuses</option>
                    <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
                    <option value="Reviewed" selected="@(selectedStatus == "Reviewed")">Reviewed</option>
                    <option value="Shortlisted" selected="@(selectedStatus == "Shortlisted")">Shortlisted</option>
                    <option value="Accepted" selected="@(selectedStatus == "Accepted")">Accepted</option>
                    <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2 pt-md-4">
                <a asp-action="Applicants" class="btn btn-outline-secondary btn-sm w-100 rounded-3">Reset</a>
            </div>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-user-xmark fs-1"></i>
            </div>
            <h5 class="fw-bold mb-1">No Applications Found</h5>
            <p class="text-muted small mb-0">There are no candidate applications matching the selected criteria.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Applicant</th>
                            <th>Applied Position</th>
                            <th>Applied Date</th>
                            <th>Status</th>
                            <th>Resume</th>
                            <th class="text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold">
                                            @(app.JobSeeker?.FullName?.Substring(0, 1).ToUpper() ?? "A")
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@(app.JobSeeker?.FullName ?? "Applicant")</div>
                                            <div class="text-muted small">@(app.JobSeeker?.Email ?? "")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@(app.Job?.Title ?? "Unknown")</div>
                                    <span class="text-muted small">@(app.Job?.Location ?? "")</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@app.AppliedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    <span class="badge @(app.Status == "Shortlisted" ? "bg-warning-subtle text-warning" : app.Status == "Accepted" ? "bg-success-subtle text-success" : app.Status == "Rejected" ? "bg-danger-subtle text-danger" : app.Status == "Reviewed" ? "bg-info-subtle text-info" : "bg-primary-subtle text-primary") rounded-pill px-3 py-1">
                                        @app.Status
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(app.ResumePath))
                                    {
                                        <a href="@app.ResumePath" target="_blank" download class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill" title="Download Resume">
                                            <i class="fa-solid fa-file-pdf me-1"></i> Resume
                                        </a>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="ApplicantDetail" asp-route-id="@app.Id" class="btn btn-sm btn-primary rounded-pill px-3">
                                        Review Dossier
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
