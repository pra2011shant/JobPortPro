@model JobPortPro.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar Profile Summary Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 bg-white sticky-top" style="top: 90px;">
                <div class="position-relative d-inline-block mx-auto mb-3">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" alt="@Model.FullName" class="rounded-circle object-fit-cover shadow-sm border border-3 border-white" style="width: 96px; height: 96px;" />
                    }
                    else
                    {
                        <div class="avatar-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold mx-auto shadow-sm" style="width: 96px; height: 96px; font-size: 2.25rem;">
                            @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                        </div>
                    }
                </div>

                <h4 class="fw-bold mb-1 text-dark">@Model.FullName</h4>
                <p class="text-muted small mb-2"><i class="fa-solid fa-envelope me-1"></i>@Model.Email</p>

                <div class="mb-3">
                    <span class="badge @(Model.Role == "Employer" ? "bg-info text-dark" : Model.Role == "Admin" ? "bg-danger" : "bg-success") rounded-pill px-3 py-1 fs-6">
                        @Model.Role
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p class="text-secondary small mt-2 mb-0 px-2 fst-italic">"@Model.Bio"</p>
                }

                @if (Model.Role == "JobSeeker" && !string.IsNullOrEmpty(Model.ResumeFileName))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 text-start border">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-file-pdf text-danger fs-4"></i>
                                <div>
                                    <span class="small fw-bold text-dark d-block">Current Resume</span>
                                    <span class="small text-muted text-truncate d-inline-block" style="max-width: 150px;">@Model.ResumeFileName</span>
                                </div>
                            </div>
                            <a href="@Model.ResumeFilePath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1" download title="Download Resume">
                                <i class="fa-solid fa-download"></i>
                            </a>
                        </div>
                    </div>
                }

                @if (Model.Role == "Employer" && !string.IsNullOrEmpty(Model.CompanyName))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 text-start border">
                        <div class="small text-muted mb-1">Company Profile</div>
                        <div class="fw-bold text-primary"><i class="fa-solid fa-building me-1"></i>@Model.CompanyName</div>
                        @if (!string.IsNullOrEmpty(Model.CompanyLocation))
                        {
                            <div class="small text-muted mt-1"><i class="fa-solid fa-location-dot me-1"></i>@Model.CompanyLocation</div>
                        }
                    </div>
                }

                <hr class="my-4">

                <div class="d-grid gap-2">
                    @if (Model.Role == "Employer")
                    {
                        <a asp-controller="Employer" asp-action="Dashboard" class="btn btn-outline-primary btn-sm rounded-pill">
                            <i class="fa-solid fa-chart-line me-1"></i> Employer Dashboard
                        </a>
                    }
                    else if (Model.Role == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-danger btn-sm rounded-pill">
                            <i class="fa-solid fa-shield-halved me-1"></i> Admin Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="JobSeeker" asp-action="Dashboard" class="btn btn-outline-primary btn-sm rounded-pill">
                            <i class="fa-solid fa-gauge-high me-1"></i> Candidate Portal
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Edit Profile Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                    <div>
                        <h3 class="fw-bold mb-1">Edit Account Profile</h3>
                        <p class="text-muted small mb-0">Update your personal details, public portfolio, and contact info</p>
                    </div>
                    <span class="badge bg-light text-muted border px-3 py-2 rounded-pill">
                        User ID: #@Model.UserId
                    </span>
                </div>

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Role" />
                    <input type="hidden" asp-for="Email" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                    <!-- Personal Information -->
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="fa-solid fa-user me-2 text-primary"></i>Personal Details
                    </h5>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="FullName" class="form-control bg-light" placeholder="Enter full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted" style="font-size: 0.75rem;"><i class="fa-solid fa-lock me-1"></i>Email is registered and cannot be modified.</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-phone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control bg-light" placeholder="+91 9876543210" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small text-muted">Update Avatar Image</label>
                            <input asp-for="ProfilePictureFile" type="file" class="form-control bg-light" accept="image/*" />
                            <span asp-validation-for="ProfilePictureFile" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Bio" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Bio" class="form-control bg-light" rows="3" placeholder="Brief intro about yourself or professional summary..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    @if (Model.Role == "JobSeeker")
                    {
                        <!-- Job Seeker Professional Details -->
                        <h5 class="fw-bold text-dark mt-4 mb-3 border-top pt-4">
                            <i class="fa-solid fa-briefcase me-2 text-primary"></i>Job Seeker Profile & Skills
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Headline" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Headline" class="form-control bg-light" placeholder="e.g. Senior ASP.NET Core & Full Stack Developer" />
                            <span asp-validation-for="Headline" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Skills" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Skills" class="form-control bg-light" placeholder="e.g. C#, ASP.NET Core, SQL Server, Entity Framework, React" />
                            <small class="text-muted">Separate skills with commas.</small>
                            <span asp-validation-for="Skills" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ExperienceYears" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="ExperienceYears" type="number" min="0" max="50" class="form-control bg-light" placeholder="e.g. 4" />
                                <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Education" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Education" class="form-control bg-light" placeholder="e.g. B.Tech Computer Science, NIT" />
                                <span asp-validation-for="Education" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="GitHubUrl" class="form-label fw-semibold small text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="fa-brands fa-github"></i></span>
                                    <input asp-for="GitHubUrl" class="form-control bg-light" placeholder="https://github.com/username" />
                                </div>
                                <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LinkedInUrl" class="form-label fw-semibold small text-muted"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="fa-brands fa-linkedin"></i></span>
                                    <input asp-for="LinkedInUrl" class="form-control bg-light" placeholder="https://linkedin.com/in/username" />
                                </div>
                                <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded-3 border">
                            <label class="form-label fw-semibold small text-dark mb-1">
                                <i class="fa-solid fa-file-pdf me-1 text-danger"></i> Upload / Replace Resume File (PDF / DOCX)
                            </label>
                            <input asp-for="ResumeUpload" type="file" class="form-control bg-white" accept=".pdf,.doc,.docx" />
                            <small class="text-muted mt-1 d-block">Employers will view and download this resume when you apply for job openings.</small>
                            <span asp-validation-for="ResumeUpload" class="text-danger small"></span>
                        </div>
                    }
                    else if (Model.Role == "Employer")
                    {
                        <!-- Employer Company Details -->
                        <h5 class="fw-bold text-dark mt-4 mb-3 border-top pt-4">
                            <i class="fa-solid fa-building me-2 text-success"></i>Company Details & Branding
                        </h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="CompanyName" class="form-control bg-light" placeholder="Enter legal company name" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanyLocation" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="CompanyLocation" class="form-control bg-light" placeholder="e.g. Bengaluru, Karnataka, India" />
                                <span asp-validation-for="CompanyLocation" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Industry" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Industry" class="form-control bg-light" placeholder="e.g. Information Technology, Healthcare, SaaS" />
                                <span asp-validation-for="Industry" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanySize" class="form-label fw-semibold small text-muted"></label>
                                <select asp-for="CompanySize" class="form-select bg-light">
                                    <option value="">Select Company Size</option>
                                    <option value="1-10 Employees">1-10 Employees</option>
                                    <option value="11-50 Employees">11-50 Employees</option>
                                    <option value="51-200 Employees">51-200 Employees</option>
                                    <option value="201-500 Employees">201-500 Employees</option>
                                    <option value="500+ Employees">500+ Employees</option>
                                </select>
                                <span asp-validation-for="CompanySize" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Website" class="form-label fw-semibold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="fa-solid fa-globe"></i></span>
                                <input asp-for="Website" class="form-control bg-light" placeholder="https://company.com" />
                            </div>
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CompanyDescription" class="form-label fw-semibold small text-muted"></label>
                            <textarea asp-for="CompanyDescription" class="form-control bg-light" rows="3" placeholder="Describe your company culture, mission, and benefits for prospective candidates..."></textarea>
                            <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-4 border-top pt-4">
                        <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-semibold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
