@model JobPortPro.Models.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="row g-4">
        <!-- Sidebar Profile Card -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                <div class="avatar-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                    @(Model.FullName.Length > 0 ? Model.FullName.Substring(0, 1).ToUpper() : "U")
                </div>
                <h5 class="fw-bold mb-1">@Model.FullName</h5>
                <p class="text-muted small mb-2">@Model.Email</p>
                <div>
                    <span class="badge @(Model.Role == "Employer" ? "bg-info text-dark" : "bg-success") rounded-pill px-3 py-1">@Model.Role</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.Bio))
                {
                    <p class="text-secondary small mt-3 mb-0">@Model.Bio</p>
                }

                @if (Model.Role == "JobSeeker" && !string.IsNullOrEmpty(Model.ResumeFileName))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 text-start">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <i class="fa-solid fa-file-pdf text-danger me-2"></i>
                                <span class="small fw-semibold">Current Resume</span>
                            </div>
                            <a href="@Model.ResumeFilePath" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2" download>
                                <i class="fa-solid fa-download"></i>
                            </a>
                        </div>
                        <div class="small text-truncate text-muted mt-1">@Model.ResumeFileName</div>
                    </div>
                }
            </div>
        </div>

        <!-- Edit Profile Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <h4 class="fw-bold mb-0">Edit Profile Information</h4>
                </div>

                <form asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Role" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Email" class="form-control" readonly disabled />
                            <small class="text-muted">Email address cannot be changed.</small>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+91 9876543210" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label fw-semibold small text-muted"></label>
                        <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Brief intro about yourself..."></textarea>
                        <span asp-validation-for="Bio" class="text-danger small"></span>
                    </div>

                    @if (Model.Role == "JobSeeker")
                    {
                        <h5 class="fw-bold text-primary mt-4 mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-graduation-cap me-2"></i> Professional Details
                        </h5>

                        <div class="mb-3">
                            <label asp-for="Headline" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Headline" class="form-control" placeholder="e.g. Senior ASP.NET Core & Full Stack Developer" />
                            <span asp-validation-for="Headline" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Skills" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Skills" class="form-control" placeholder="e.g. C#, ASP.NET Core, SQL Server, Entity Framework, React" />
                            <small class="text-muted">Separate skills with commas.</small>
                            <span asp-validation-for="Skills" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ExperienceYears" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="ExperienceYears" type="number" min="0" max="50" class="form-control" placeholder="e.g. 4" />
                                <span asp-validation-for="ExperienceYears" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Education" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Education" class="form-control" placeholder="e.g. B.Tech Computer Science" />
                                <span asp-validation-for="Education" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="GitHubUrl" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="GitHubUrl" class="form-control" placeholder="https://github.com/username" />
                                <span asp-validation-for="GitHubUrl" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LinkedInUrl" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/username" />
                                <span asp-validation-for="LinkedInUrl" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-muted">Upload / Update Resume (PDF, DOCX)</label>
                            <input asp-for="ResumeUpload" type="file" class="form-control" accept=".pdf,.doc,.docx" />
                            <span asp-validation-for="ResumeUpload" class="text-danger small"></span>
                        </div>
                    }
                    else if (Model.Role == "Employer")
                    {
                        <h5 class="fw-bold text-success mt-4 mb-3 border-bottom pb-2">
                            <i class="fa-solid fa-building me-2"></i> Company Information
                        </h5>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="CompanyName" class="form-control" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanyLocation" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="CompanyLocation" class="form-control" placeholder="e.g. Bengaluru, Karnataka, India" />
                                <span asp-validation-for="CompanyLocation" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Industry" class="form-label fw-semibold small text-muted"></label>
                                <input asp-for="Industry" class="form-control" placeholder="e.g. Information Technology, Healthcare" />
                                <span asp-validation-for="Industry" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanySize" class="form-label fw-semibold small text-muted"></label>
                                <select asp-for="CompanySize" class="form-select">
                                    <option value="">Select size</option>
                                    <option value="1-10 Employees">1-10 Employees</option>
                                    <option value="11-50 Employees">11-50 Employees</option>
                                    <option value="51-200 Employees">51-200 Employees</option>
                                    <option value="201-500 Employees">201-500 Employees</option>
                                    <option value="500+ Employees">500+ Employees</option>
                                </select>
                                <span asp-validation-for="CompanySize" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Website" class="form-label fw-semibold small text-muted"></label>
                            <input asp-for="Website" class="form-control" placeholder="https://company.com" />
                            <span asp-validation-for="Website" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CompanyDescription" class="form-label fw-semibold small text-muted"></label>
                            <textarea asp-for="CompanyDescription" class="form-control" rows="3" placeholder="Tell candidates about your company mission and culture..."></textarea>
                            <span asp-validation-for="CompanyDescription" class="text-danger small"></span>
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
