@model JobPortPro.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="p-4 p-sm-5 bg-white">
                    <div class="text-center mb-4">
                        <div class="brand-icon d-inline-flex align-items-center justify-content-center text-white bg-primary rounded-3 mb-3 mx-auto">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <h3 class="fw-bold mb-1">Reset Your Password</h3>
                        <p class="text-muted small">Enter your registered email address to reset your account password</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold small text-muted"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-envelope"></i></span>
                                <input asp-for="Email" class="form-control bg-light border-start-0" placeholder="name@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mb-3 shadow-sm">
                            <i class="fa-solid fa-arrow-right me-1"></i> Continue
                        </button>
                    </form>

                    <div class="text-center">
                        <p class="small text-muted mb-0">Remembered your password? 
                            <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Back to Sign In</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
