@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-5">
                <div class="text-danger mb-3">
                    <i class="fa-solid fa-lock fs-1"></i>
                </div>
                <h3 class="fw-bold mb-2">Access Denied</h3>
                <p class="text-muted mb-4">You do not have permission to view this resource. Please make sure you are logged in with the correct role (Employer or Job Seeker).</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
                        <i class="fa-solid fa-house me-1"></i> Return Home
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In With Another Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
