<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobPortPro | Find Your Dream Career</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-primary" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon d-inline-flex align-items-center justify-content-center text-white bg-primary rounded-3">
                        <i class="fa-solid fa-briefcase"></i>
                    </span>
                    <span class="brand-text">JobPort<span class="text-secondary-gradient">Pro</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1 text-muted"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Jobs" asp-action="Index">
                                <i class="fa-solid fa-magnifying-glass me-1 text-muted"></i> Explore Jobs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="About">
                                <i class="fa-solid fa-circle-info me-1 text-muted"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium text-dark" asp-controller="Home" asp-action="Contact">
                                <i class="fa-solid fa-envelope me-1 text-muted"></i> Contact
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
                            var userName = User.Identity.Name ?? "Account";

                            if (role == "Employer")
                            {
                                <li class="nav-item">
                                    <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-controller="Employer" asp-action="PostJob">
                                        <i class="fa-solid fa-plus me-1"></i> Post a Job
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-light btn-sm rounded-pill px-3" asp-controller="Employer" asp-action="Applicants">
                                        <i class="fa-solid fa-users me-1 text-primary"></i> Applicants
                                    </a>
                                </li>
                            }
                            else if (role == "JobSeeker")
                            {
                                <li class="nav-item">
                                    <a class="nav-link fw-medium position-relative me-2" asp-controller="JobSeeker" asp-action="AppliedJobs">
                                        <i class="fa-solid fa-paper-plane me-1 text-primary"></i> My Applications
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link fw-medium position-relative me-2" asp-controller="JobSeeker" asp-action="SavedJobs">
                                        <i class="fa-solid fa-bookmark me-1 text-warning"></i> Saved
                                    </a>
                                </li>
                            }

                            <!-- User Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-dark fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold">
                                        @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <span>@userName</span>
                                    <span class="badge @(role == "Employer" ? "bg-info text-dark" : "bg-success") rounded-pill ms-1" style="font-size: 0.7rem;">@role</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 p-2" style="min-width: 220px;">
                                    @if (role == "Employer")
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="Employer" asp-action="Dashboard">
                                                <i class="fa-solid fa-chart-line me-2 text-primary"></i> Employer Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="Employer" asp-action="ManageJobs">
                                                <i class="fa-solid fa-list-check me-2 text-primary"></i> Manage Jobs
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="JobSeeker" asp-action="Dashboard">
                                                <i class="fa-solid fa-gauge-high me-2 text-primary"></i> Seeker Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 rounded-2" asp-controller="JobSeeker" asp-action="AppliedJobs">
                                                <i class="fa-solid fa-file-lines me-2 text-primary"></i> Applied Jobs
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item py-2 rounded-2" asp-controller="Account" asp-action="Profile">
                                            <i class="fa-solid fa-user-gear me-2 text-secondary"></i> Edit Profile
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item py-2 rounded-2 text-danger">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-dark px-3" asp-controller="Account" asp-action="Login">
                                    <i class="fa-solid fa-right-to-bracket me-1 text-muted"></i> Sign In
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="btn btn-primary rounded-pill px-3 dropdown-toggle shadow-sm" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fa-solid fa-user-plus me-1"></i> Register
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2 p-2">
                                    <li>
                                        <a class="dropdown-item py-2 rounded-2" asp-controller="Account" asp-action="Register" asp-route-role="JobSeeker">
                                            <i class="fa-solid fa-user me-2 text-primary"></i> As Job Seeker
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 rounded-2" asp-controller="Account" asp-action="Register" asp-route-role="Employer">
                                            <i class="fa-solid fa-building me-2 text-success"></i> As Employer
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Flash Messages / Alerts -->
    <main role="main" class="flex-grow-1 pb-5">
        <div class="container pt-3">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-circle-check fs-5 me-2"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-triangle-exclamation fs-5 me-2"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5 me-2"></i>
                    <div>@TempData["WarningMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-3 border-top mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon d-inline-flex align-items-center justify-content-center text-white bg-primary rounded-3">
                            <i class="fa-solid fa-briefcase"></i>
                        </span>
                        <h4 class="fw-bold mb-0 text-white">JobPort<span class="text-primary-accent">Pro</span></h4>
                    </div>
                    <p class="text-secondary small mb-3">
                        JobPortPro connects top-tier talent with ambitious companies worldwide. Find verified jobs, hire high-performing engineers, designers, marketers and leaders.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-btn text-white"><i class="fa-brands fa-linkedin-in"></i></a>
                        <a href="#" class="social-btn text-white"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" class="social-btn text-white"><i class="fa-brands fa-github"></i></a>
                        <a href="#" class="social-btn text-white"><i class="fa-brands fa-facebook-f"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3">For Candidates</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a asp-controller="Jobs" asp-action="Index">Browse All Jobs</a></li>
                        <li><a asp-controller="Jobs" asp-action="Index" asp-route-jobType="Remote">Remote Jobs</a></li>
                        <li><a asp-controller="Account" asp-action="Register" asp-route-role="JobSeeker">Candidate Sign Up</a></li>
                        <li><a asp-controller="JobSeeker" asp-action="Dashboard">Candidate Portal</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3">For Employers</h6>
                    <ul class="list-unstyled footer-links small">
                        <li><a asp-controller="Employer" asp-action="PostJob">Post a Job Opening</a></li>
                        <li><a asp-controller="Employer" asp-action="Dashboard">Employer Dashboard</a></li>
                        <li><a asp-controller="Employer" asp-action="Applicants">Applicant Tracking</a></li>
                        <li><a asp-controller="Account" asp-action="Register" asp-route-role="Employer">Employer Registration</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-white mb-3">Stay Updated</h6>
                    <p class="text-secondary small mb-3">Subscribe to get weekly notifications about high-paying job opportunities.</p>
                    <div class="input-group">
                        <input type="email" class="form-control bg-dark-subtle text-white border-secondary" placeholder="Enter your email">
                        <button class="btn btn-primary" type="button">Subscribe</button>
                    </div>
                </div>
            </div>

            <hr class="border-secondary opacity-25" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-secondary">
                <div>&copy; @DateTime.UtcNow.Year JobPortPro. Built with ASP.NET Core MVC & SQL Server.</div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="About" class="text-secondary text-decoration-none">Terms of Service</a>
                    <a asp-controller="Home" asp-action="Contact" class="text-secondary text-decoration-none">Help & Support</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
