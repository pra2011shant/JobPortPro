@model JobPortPro.Models.Job
@{
    ViewData["Title"] = Model.Title;
    bool hasApplied = ViewBag.HasApplied == true;
    bool isSaved = ViewBag.IsSaved == true;
    var relatedJobs = ViewBag.RelatedJobs as List<JobPortPro.Models.Job> ?? new List<JobPortPro.Models.Job>();
    var isEmployer = User.IsInRole("Employer");
    var isJobSeeker = User.IsInRole("JobSeeker");
}

<div class="container py-4">
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index" class="text-decoration-none text-muted">Jobs</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- Header Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
        <div class="row g-4 align-items-center">
            <div class="col-auto">
                <div class="company-logo-box" style="width: 70px; height: 70px; font-size: 2rem;">
                    @(Model.Employer?.CompanyProfile?.CompanyName?.Substring(0, 1).ToUpper() ?? "C")
                </div>
            </div>
            <div class="col">
                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <span class="badge @((Model.JobTypeEntity?.Name ?? Model.JobType) == "Remote" ? "badge-soft-success" : (Model.JobTypeEntity?.Name ?? Model.JobType) == "Full-Time" ? "badge-soft-primary" : "badge-soft-warning") rounded-pill px-3 py-1">
                        @(Model.JobTypeEntity?.Name ?? Model.JobType)
                    </span>
                    <span class="badge bg-light text-secondary rounded-pill border px-3 py-1">
                        @(Model.Category?.Name ?? "General")
                    </span>
                    @if (!string.IsNullOrEmpty(Model.ExperienceLevelEntity?.Title ?? Model.ExperienceLevel))
                    {
                        <span class="badge bg-light text-dark rounded-pill border px-3 py-1">
                            @(Model.ExperienceLevelEntity?.Title ?? Model.ExperienceLevel)
                        </span>
                    }
                </div>

                <h2 class="fw-bold mb-2">@Model.Title</h2>
                <div class="d-flex flex-wrap gap-4 text-muted small">
                    <span class="fw-semibold text-primary">
                        <i class="fa-solid fa-building me-1"></i>@(Model.Employer?.CompanyProfile?.CompanyName ?? "Company")
                    </span>
                    <span>
                        <i class="fa-solid fa-location-dot me-1 text-secondary"></i>@Model.Location
                    </span>
                    @if (Model.SalaryMin.HasValue || Model.SalaryMax.HasValue)
                    {
                        <span class="text-success fw-semibold">
                            <i class="fa-solid fa-indian-rupee-sign me-1"></i>@string.Format("{0:N0}", Model.SalaryMin) - @string.Format("{0:N0}", Model.SalaryMax) / yr
                        </span>
                    }
                    <span>
                        <i class="fa-regular fa-clock me-1 text-muted"></i>Posted @Model.CreatedAt.ToString("MMM dd, yyyy")
                    </span>
                </div>
            </div>

            <div class="col-12 col-md-auto text-md-end d-flex flex-wrap gap-2">
                @if (isJobSeeker)
                {
                    <form asp-action="ToggleSave" asp-route-id="@Model.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn @(isSaved ? "btn-warning text-dark" : "btn-outline-secondary") rounded-pill px-3 py-2">
                            <i class="fa-solid fa-bookmark me-1"></i> @(isSaved ? "Saved" : "Save Job")
                        </button>
                    </form>

                    @if (hasApplied)
                    {
                        <button class="btn btn-success rounded-pill px-4 py-2" disabled>
                            <i class="fa-solid fa-circle-check me-1"></i> Applied
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#applyModal">
                            <i class="fa-solid fa-paper-plane me-1"></i> Quick Apply
                        </button>
                    }
                }
                else if (isEmployer)
                {
                    <a asp-controller="Employer" asp-action="EditJob" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4 py-2">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Job
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In to Apply
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
                <!-- Description -->
                <h4 class="fw-bold mb-3">Job Description</h4>
                <div class="text-secondary mb-4" style="line-height: 1.8; white-space: pre-line;">
                    @Model.Description
                </div>

                <!-- Responsibilities -->
                @if (!string.IsNullOrWhiteSpace(Model.Responsibilities))
                {
                    <h4 class="fw-bold mb-3 border-top pt-4">Key Responsibilities</h4>
                    <div class="text-secondary mb-4" style="line-height: 1.8; white-space: pre-line;">
                        @Model.Responsibilities
                    </div>
                }

                <!-- Requirements -->
                @if (!string.IsNullOrWhiteSpace(Model.Requirements))
                {
                    <h4 class="fw-bold mb-3 border-top pt-4">Qualifications & Requirements</h4>
                    <div class="text-secondary mb-4" style="line-height: 1.8; white-space: pre-line;">
                        @Model.Requirements
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Details -->
        <div class="col-lg-4">
            <!-- Job Overview Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3">Job Summary</h5>
                <ul class="list-unstyled d-flex flex-column gap-3 mb-0 small">
                    <li class="d-flex align-items-center gap-3">
                        <i class="fa-solid fa-layer-group text-primary fs-5"></i>
                        <div>
                            <div class="text-muted">Industry Category</div>
                            <div class="fw-semibold">@(Model.Category?.Name ?? "General")</div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <i class="fa-solid fa-business-time text-primary fs-5"></i>
                        <div>
                            <div class="text-muted">Employment Type</div>
                            <div class="fw-semibold">@(Model.JobTypeEntity?.Name ?? Model.JobType)</div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <i class="fa-solid fa-graduation-cap text-primary fs-5"></i>
                        <div>
                            <div class="text-muted">Experience Level</div>
                            <div class="fw-semibold">@(Model.ExperienceLevelEntity?.Title ?? Model.ExperienceLevel ?? "Any")</div>
                        </div>
                    </li>
                    <li class="d-flex align-items-center gap-3">
                        <i class="fa-solid fa-calendar-xmark text-primary fs-5"></i>
                        <div>
                            <div class="text-muted">Application Deadline</div>
                            <div class="fw-semibold">@(Model.Deadline?.ToString("MMM dd, yyyy") ?? "Open until filled")</div>
                        </div>
                    </li>
                </ul>
            </div>

            <!-- Company Info Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold mb-3">About the Company</h5>
                <h6 class="fw-bold text-primary mb-1">@(Model.Employer?.CompanyProfile?.CompanyName ?? "Company")</h6>
                <p class="text-muted small mb-3">@(Model.Employer?.CompanyProfile?.Description ?? "A leading employer hiring verified talent through JobPortPro.")</p>

                @if (!string.IsNullOrEmpty(Model.Employer?.CompanyProfile?.Website))
                {
                    <a href="@Model.Employer?.CompanyProfile?.Website" target="_blank" class="btn btn-outline-secondary btn-sm w-100 rounded-pill">
                        <i class="fa-solid fa-globe me-1"></i> Visit Website
                    </a>
                }
            </div>

            <!-- Related Jobs -->
            @if (relatedJobs.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold mb-3">Related Positions</h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rel in relatedJobs)
                        {
                            <div class="border-bottom pb-2">
                                <h6 class="fw-bold mb-0">
                                    <a asp-action="Details" asp-route-id="@rel.Id" class="text-dark text-decoration-none">@rel.Title</a>
                                </h6>
                                <small class="text-muted">@(rel.Employer?.CompanyProfile?.CompanyName ?? "Company") • @rel.Location</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Quick Apply Modal -->
@if (isJobSeeker && !hasApplied)
{
    <div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="applyModalLabel">
                        <i class="fa-solid fa-paper-plane me-2"></i>Apply for @Model.Title
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Apply" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="JobId" value="@Model.Id" />
                    <input type="hidden" name="JobTitle" value="@Model.Title" />
                    <input type="hidden" name="CompanyName" value="@(Model.Employer?.CompanyProfile?.CompanyName ?? "Company")" />
                    <input type="hidden" name="Location" value="@Model.Location" />

                    <div class="modal-body p-4 bg-white">
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-muted">Cover Letter / Note to Employer</label>
                            <textarea name="CoverLetter" class="form-control" rows="4" placeholder="Briefly state your suitability for this position..."></textarea>
                        </div>

                        <div class="mb-3 p-3 bg-light rounded-3">
                            <label class="form-label fw-semibold small text-muted">Upload Resume (PDF/DOCX)</label>
                            <input type="file" name="ResumeFile" class="form-control" accept=".pdf,.doc,.docx" />
                            <small class="text-muted mt-1 d-block">If you have a resume in your profile, leaving this blank will use your profile resume.</small>
                        </div>
                    </div>
                    <div class="modal-footer bg-light border-0 py-3">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold shadow-sm">
                            <i class="fa-solid fa-paper-plane me-1"></i> Submit Application
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
